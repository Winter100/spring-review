# 실제 값은 .env에 입력합니다. .env는 Git에서 제외됩니다.
# KEY=VALUE 형식을 사용하며 값에 따옴표나 export를 붙이지 않습니다.

# 실제 값은 .env에만 입력합니다. JWT 키는 32바이트 이상의 값을 Base64로 인코딩합니다.
JWT_SECRET_BASE64=YOUR_BASE64_ENCODED_JWT_SECRET
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# Cloudflare R2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=review-images
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_PUBLIC_BASE_URL=https://pub-YOUR_PUBLIC_ID.r2.dev
